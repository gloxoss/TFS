# =============================================================================
# TFS Production Environment Template
# =============================================================================
# Copy this file to .env on the VPS and fill in the values
# NEVER commit the actual .env file with real credentials!
# =============================================================================

# PocketBase Configuration
# Internal URL (container-to-container communication)
POCKETBASE_URL=http://pocketbase:8090

# Public URL (how the browser reaches PocketBase API)
# For production with Nginx proxy, this becomes relative:
NEXT_PUBLIC_POCKETBASE_URL=/api

# PocketBase Admin Credentials
# CHANGE THESE IN PRODUCTION!
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =============================================================================
# Site Configuration
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=TFS Equipment Rentals

# =============================================================================
# Email Service (Resend)
# =============================================================================
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXX
EMAIL_FROM=TFS <noreply@your-domain.com>
ADMIN_EMAIL=admin@your-domain.com

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_ENABLE_DIGITAL_SIGNATURE=false
ENABLE_CLIENT_PORTAL=false

# =============================================================================
# Optional: AI Chat
# =============================================================================
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-XXXXXXXX
# AI_MODEL=mistralai/devstral-2512:free

# =============================================================================
# Version (set by deployment script)
# =============================================================================
VERSION=latest
